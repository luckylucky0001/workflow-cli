{
  "$id": "docs/schemas/container.workload.get.v1.json",
  "title": "container.workload.get data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "string"
    },
    "env": {
      "type": [
        "string",
        "null"
      ]
    },
    "selector": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "label",
            "name"
          ],
          "description": "label=按 Docker 标签 / Kubernetes 标签选择器；name=按资源绑定中声明的精确容器名"
        },
        "label": {
          "type": "string",
          "description": "Docker: key=value；Kubernetes: labelSelector 字符串（如 app=demo-order,tier=web）"
        },
        "origin": {
          "type": "string",
          "enum": [
            "binding-file",
            "label-convention"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "matched_by": {
          "type": "string",
          "description": "实际匹配到容器的选择器，如 label workctl.resource=demo-mysql、binding attribute container=demo-mysql，或 Kubernetes label selector app=demo-order（Deployment demo/demo-order 的 spec.selector）"
        }
      },
      "required": [
        "kind",
        "label",
        "origin",
        "evidence",
        "matched_by"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "string",
      "enum": [
        "docker",
        "kubernetes"
      ]
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "service": {
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "type": [
              "string",
              "null"
            ]
          },
          "image": {
            "type": "string"
          },
          "image_id": {
            "type": "string"
          },
          "created": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "description": "Docker State.Status：running/exited/restarting/paused/created/dead"
          },
          "health": {
            "type": "string",
            "description": "healthy/unhealthy/starting；未配置健康检查为 none"
          },
          "health_failing_streak": {
            "type": [
              "number",
              "null"
            ]
          },
          "last_health_check": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "string"
                  },
                  "exit_code": {
                    "type": "number"
                  },
                  "output": {
                    "type": "string"
                  }
                },
                "required": [
                  "at",
                  "exit_code",
                  "output"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "restart_count": {
            "type": "number",
            "description": "Docker RestartCount：仅统计重启策略触发的重启，不含手动 restart"
          },
          "restart_policy": {
            "type": [
              "string",
              "null"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "description": "最近一次退出时间；从未退出为 null",
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": "number"
          },
          "oom_killed": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "container_port": {
                  "type": "number"
                },
                "protocol": {
                  "type": "string"
                },
                "host_ip": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "host_port": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "container_port",
                "protocol",
                "host_ip",
                "host_port"
              ],
              "additionalProperties": false
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "cpus": {
                "description": "CPU 上限（核）；null 表示未限制",
                "type": [
                  "number",
                  "null"
                ]
              },
              "memory_bytes": {
                "description": "内存上限；null 表示未限制",
                "type": [
                  "number",
                  "null"
                ]
              },
              "memory_reservation_bytes": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "pids_limit": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "cpus",
              "memory_bytes",
              "memory_reservation_bytes",
              "pids_limit"
            ],
            "additionalProperties": false
          },
          "log_driver": {
            "type": [
              "string",
              "null"
            ]
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "ip": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "ip",
                "aliases"
              ],
              "additionalProperties": false
            }
          },
          "mounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                },
                "destination": {
                  "type": "string"
                },
                "rw": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "name",
                "source",
                "destination",
                "rw"
              ],
              "additionalProperties": false
            }
          },
          "labels": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "kubernetes": {
            "description": "仅 Kubernetes provider：Pod 与容器的原生状态（name 为 <pod>/<container>）",
            "type": "object",
            "properties": {
              "namespace": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pod": {
                "type": "string"
              },
              "container": {
                "type": "string"
              },
              "pod_uid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "node": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phase": {
                "description": "Pod phase：Pending/Running/Succeeded/Failed/Unknown",
                "type": [
                  "string",
                  "null"
                ]
              },
              "pod_ready": {
                "description": "Pod 条件 Ready",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "container_ready": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "qos_class": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "owner": {
                "description": "控制者 ownerReference，如 ReplicaSet/demo-order-7c9d8f6b5",
                "type": [
                  "string",
                  "null"
                ]
              },
              "state_reason": {
                "description": "waiting/terminated 原因，如 CrashLoopBackOff、ImagePullBackOff、OOMKilled",
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_termination": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "reason": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "exit_code": {
                        "type": "number"
                      },
                      "finished_at": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "reason",
                      "exit_code",
                      "finished_at"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "lastState.terminated"
              },
              "requests": {
                "type": "object",
                "properties": {
                  "cpus": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "memory_bytes": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "cpus",
                  "memory_bytes"
                ],
                "additionalProperties": false
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "namespace",
              "pod",
              "container",
              "pod_uid",
              "node",
              "phase",
              "pod_ready",
              "container_ready",
              "qos_class",
              "owner",
              "state_reason",
              "last_termination",
              "requests",
              "conditions"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "service",
          "env",
          "image",
          "image_id",
          "created",
          "state",
          "health",
          "health_failing_streak",
          "last_health_check",
          "restart_count",
          "restart_policy",
          "started_at",
          "finished_at",
          "exit_code",
          "oom_killed",
          "error",
          "ports",
          "limits",
          "log_driver",
          "networks",
          "mounts",
          "labels"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number"
        },
        "running": {
          "type": "number"
        },
        "unhealthy": {
          "type": "number"
        },
        "oom_killed": {
          "type": "number"
        },
        "restarted": {
          "type": "number"
        }
      },
      "required": [
        "total",
        "running",
        "unhealthy",
        "oom_killed",
        "restarted"
      ],
      "additionalProperties": false
    },
    "kubernetes": {
      "description": "仅 Kubernetes provider：工作负载 rollout 状态与 Pod 列表",
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "server_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "label_selector": {
          "type": "string"
        },
        "workloads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "uid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "generation": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "observed_generation": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "replicas": {
                "type": "number"
              },
              "ready_replicas": {
                "type": "number"
              },
              "updated_replicas": {
                "type": "number"
              },
              "available_replicas": {
                "type": "number"
              },
              "selector": {
                "type": "string"
              },
              "progressing": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string"
                      },
                      "reason": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "status",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "restarted_at": {
                "description": "Pod 模板注解 kubectl.kubernetes.io/restartedAt",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "name",
              "namespace",
              "uid",
              "generation",
              "observed_generation",
              "replicas",
              "ready_replicas",
              "updated_replicas",
              "available_replicas",
              "selector",
              "progressing",
              "restarted_at"
            ],
            "additionalProperties": false
          }
        },
        "pods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "phase": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ready": {
                "type": "boolean"
              },
              "node": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pod_ip": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start_time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "restarts": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "phase",
              "ready",
              "node",
              "pod_ip",
              "start_time",
              "restarts"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "endpoint",
        "namespace",
        "server_version",
        "label_selector",
        "workloads",
        "pods"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "service",
    "env",
    "selector",
    "provider",
    "containers",
    "summary"
  ],
  "additionalProperties": false
}
