{
  "$id": "docs/schemas/redis.key.inspect.v1.json",
  "title": "redis.key.inspect data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instance": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "ttl_ms": {
      "description": "剩余 TTL（毫秒）；null 表示没有过期时间",
      "type": [
        "number",
        "null"
      ]
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "encoding": {
      "type": [
        "string",
        "null"
      ]
    },
    "memory_bytes": {
      "description": "MEMORY USAGE SAMPLES 5，近似值",
      "type": [
        "number",
        "null"
      ]
    },
    "length": {
      "description": "STRLEN/LLEN/HLEN/SCARD/ZCARD/XLEN",
      "type": [
        "number",
        "null"
      ]
    },
    "lfu_counter": {
      "type": [
        "number",
        "null"
      ]
    },
    "lfu_note": {
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "string",
                "list",
                "hash",
                "set",
                "zset",
                "stream"
              ]
            },
            "encoding": {
              "type": "string",
              "enum": [
                "utf8",
                "base64",
                "mixed"
              ]
            },
            "data": {},
            "returned": {
              "type": "number"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "encoding",
            "data",
            "returned",
            "truncated"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "instance",
    "key",
    "type",
    "ttl_ms",
    "expires_at",
    "encoding",
    "memory_bytes",
    "length",
    "lfu_counter",
    "lfu_note",
    "value"
  ],
  "additionalProperties": false
}
