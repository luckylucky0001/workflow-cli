{
  "$id": "docs/schemas/postgres.session.list.v1.json",
  "title": "postgres.session.list data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instance": {
      "type": "string"
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "number"
          },
          "user": {
            "type": [
              "string",
              "null"
            ]
          },
          "database": {
            "type": [
              "string",
              "null"
            ]
          },
          "application_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "client_addr": {
            "type": [
              "string",
              "null"
            ]
          },
          "backend_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "description": "active / idle / idle in transaction / idle in transaction (aborted) / fastpath function call / disabled",
            "type": [
              "string",
              "null"
            ]
          },
          "wait_event_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "wait_event": {
            "type": [
              "string",
              "null"
            ]
          },
          "backend_start": {
            "type": [
              "string",
              "null"
            ]
          },
          "xact_start": {
            "type": [
              "string",
              "null"
            ]
          },
          "xact_age_s": {
            "description": "当前事务已持续秒数",
            "type": [
              "number",
              "null"
            ]
          },
          "query_start": {
            "type": [
              "string",
              "null"
            ]
          },
          "query_age_s": {
            "description": "active：当前语句已执行秒数；其它状态：最后一条语句开始至今",
            "type": [
              "number",
              "null"
            ]
          },
          "state_age_s": {
            "description": "处于当前 state 的秒数（idle in transaction 的空闲时长）",
            "type": [
              "number",
              "null"
            ]
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "pg_blocking_pids()：阻塞该会话的 pid"
          },
          "query": {
            "description": "当前/最后一条语句，字面量替换为 ?，截断至 512 字符；无权限查看时为 null",
            "type": [
              "string",
              "null"
            ]
          },
          "query_truncated": {
            "type": "boolean"
          },
          "query_hidden": {
            "type": "boolean",
            "description": "pg_stat_activity 对当前角色隐藏了该会话详情（<insufficient privilege>）"
          }
        },
        "required": [
          "pid",
          "user",
          "database",
          "application_name",
          "client_addr",
          "backend_type",
          "state",
          "wait_event_type",
          "wait_event",
          "backend_start",
          "xact_start",
          "xact_age_s",
          "query_start",
          "query_age_s",
          "state_age_s",
          "blocked_by",
          "query",
          "query_truncated",
          "query_hidden"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_visible": {
          "type": "number"
        },
        "returned": {
          "type": "number"
        },
        "active": {
          "type": "number"
        },
        "idle_in_transaction": {
          "type": "number",
          "description": "idle in transaction（含 aborted）：持有事务与锁却不执行语句，常见锁源"
        },
        "waiting_on_lock": {
          "type": "number",
          "description": "wait_event_type=Lock 的会话"
        },
        "blocked": {
          "type": "number",
          "description": "pg_blocking_pids 非空的会话"
        },
        "oldest_xact_age_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "hidden_details": {
          "type": "number",
          "description": "详情被隐藏的会话数（缺 pg_read_all_stats）"
        }
      },
      "required": [
        "total_visible",
        "returned",
        "active",
        "idle_in_transaction",
        "waiting_on_lock",
        "blocked",
        "oldest_xact_age_s",
        "hidden_details"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "instance",
    "sessions",
    "summary"
  ],
  "additionalProperties": false
}
