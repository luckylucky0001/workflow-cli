{
  "$id": "docs/schemas/sql.query.get.v1.json",
  "title": "sql.query.get data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query_id": {
      "type": "string"
    },
    "engine": {
      "type": "string",
      "enum": [
        "spark",
        "trino"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "submitted",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "lost"
      ]
    },
    "state_basis": {
      "type": "string"
    },
    "submitted_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "app_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "spark_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "sql_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "sql_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "row_count": {
      "type": [
        "number",
        "null"
      ]
    },
    "columns": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "preview": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "preview_truncated": {
      "type": "boolean"
    },
    "result_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_format": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "error_type": {
              "description": "Trino errorType: USER_ERROR / INTERNAL_ERROR / INSUFFICIENT_RESOURCES / EXTERNAL",
              "type": "string"
            },
            "error_code": {
              "type": "number"
            },
            "sql_state": {
              "type": "string"
            },
            "line": {
              "type": "number"
            },
            "column": {
              "type": "number"
            },
            "code": {
              "description": "对应的 workctl 错误码（仅 Trino）",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "views": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "engine_query_id": {
      "description": "Trino query id",
      "type": [
        "string",
        "null"
      ]
    },
    "engine_state": {
      "description": "引擎原始状态（Trino: QUEUED/PLANNING/STARTING/RUNNING/FINISHING/FINISHED/FAILED）",
      "type": [
        "string",
        "null"
      ]
    },
    "engine_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "column_types": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "catalog": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "stats": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "elapsed_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "queued_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "cpu_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "wall_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "processed_rows": {
              "type": [
                "number",
                "null"
              ]
            },
            "processed_bytes": {
              "type": [
                "number",
                "null"
              ]
            },
            "physical_input_bytes": {
              "type": [
                "number",
                "null"
              ]
            },
            "peak_memory_bytes": {
              "type": [
                "number",
                "null"
              ]
            },
            "spilled_bytes": {
              "type": [
                "number",
                "null"
              ]
            },
            "completed_splits": {
              "type": [
                "number",
                "null"
              ]
            },
            "total_splits": {
              "type": [
                "number",
                "null"
              ]
            },
            "nodes": {
              "type": [
                "number",
                "null"
              ]
            },
            "progress_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "statement",
                "query-info"
              ],
              "description": "statement=结果页 stats；query-info=GET /v1/query/{id}"
            }
          },
          "required": [
            "elapsed_ms",
            "queued_ms",
            "cpu_ms",
            "wall_ms",
            "processed_rows",
            "processed_bytes",
            "physical_input_bytes",
            "peak_memory_bytes",
            "spilled_bytes",
            "completed_splits",
            "total_splits",
            "nodes",
            "progress_pct",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "query_id",
    "engine",
    "state",
    "state_basis",
    "submitted_at",
    "started_at",
    "finished_at",
    "duration_ms",
    "app_id",
    "spark_version",
    "sql_file",
    "sql_sha256",
    "row_count",
    "columns",
    "preview",
    "preview_truncated",
    "result_location",
    "result_format",
    "error",
    "views"
  ],
  "additionalProperties": false
}
