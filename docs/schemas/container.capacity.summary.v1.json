{
  "$id": "docs/schemas/container.capacity.summary.v1.json",
  "title": "container.capacity.summary data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "snapshot"
    },
    "observed_at": {
      "type": "string"
    },
    "env": {
      "type": "string"
    },
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "ncpu": {
          "type": "number",
          "description": "Docker 主机 CPU 数；Kubernetes 为节点 allocatable 合计（无 list nodes 权限时为 0，见 kubernetes.capacity_known）"
        },
        "mem_total_bytes": {
          "type": "number"
        },
        "docker_version": {
          "type": "string",
          "description": "Docker 版本；Kubernetes 为节点容器运行时版本（containerRuntimeVersion）"
        },
        "cgroup_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string",
          "enum": [
            "docker",
            "kubernetes"
          ]
        },
        "kubernetes": {
          "description": "仅 Kubernetes provider",
          "type": "object",
          "properties": {
            "server_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "nodes": {
              "type": [
                "number",
                "null"
              ]
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "capacity_known": {
              "type": "boolean"
            }
          },
          "required": [
            "server_version",
            "nodes",
            "namespaces",
            "capacity_known"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "ncpu",
        "mem_total_bytes",
        "docker_version",
        "cgroup_version"
      ],
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "properties": {
        "containers": {
          "type": "number"
        },
        "running": {
          "type": "number"
        },
        "cpu_limit_sum": {
          "type": "number"
        },
        "cpu_unlimited": {
          "type": "number"
        },
        "memory_limit_sum_bytes": {
          "type": "number"
        },
        "memory_unlimited": {
          "type": "number"
        },
        "cpu_used_cores": {
          "type": "number"
        },
        "memory_working_set_bytes": {
          "type": "number"
        },
        "cpu_limit_to_host_ratio": {
          "type": "number"
        },
        "memory_limit_to_host_ratio": {
          "type": "number"
        },
        "cpu_request_sum": {
          "description": "仅 Kubernetes：requests.cpu 合计",
          "type": "number"
        },
        "memory_request_sum_bytes": {
          "description": "仅 Kubernetes：requests.memory 合计",
          "type": "number"
        }
      },
      "required": [
        "containers",
        "running",
        "cpu_limit_sum",
        "cpu_unlimited",
        "memory_limit_sum_bytes",
        "memory_unlimited",
        "cpu_used_cores",
        "memory_working_set_bytes",
        "cpu_limit_to_host_ratio",
        "memory_limit_to_host_ratio"
      ],
      "additionalProperties": false
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Docker 容器名；Kubernetes 为 <pod>/<container>"
          },
          "id": {
            "type": "string"
          },
          "owner_label": {
            "description": "workctl.service 或 workctl.resource 标签",
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string"
          },
          "limits": {
            "type": "object",
            "properties": {
              "cpus": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "memory_bytes": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "cpus",
              "memory_bytes"
            ],
            "additionalProperties": false
          },
          "usage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "cpu_cores": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "cpu_percent_of_limit": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "memory_working_set_bytes": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "memory_percent_of_limit": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "pids": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "cpu_cores",
                  "cpu_percent_of_limit",
                  "memory_working_set_bytes",
                  "memory_percent_of_limit",
                  "pids"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "oom_killed": {
            "type": "boolean"
          },
          "restart_count": {
            "type": "number"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "no_cpu_limit、no_memory_limit、cpu/memory_above_80pct_of_limit、oom_killed_last_exit、auto_restarted；Kubernetes 另有 no_cpu_request、no_memory_request"
          },
          "namespace": {
            "description": "仅 Kubernetes",
            "type": [
              "string",
              "null"
            ]
          },
          "node": {
            "description": "仅 Kubernetes",
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "description": "仅 Kubernetes：控制者 ownerReference",
            "type": [
              "string",
              "null"
            ]
          },
          "requests": {
            "description": "仅 Kubernetes：resources.requests",
            "type": "object",
            "properties": {
              "cpus": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "memory_bytes": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "cpus",
              "memory_bytes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "id",
          "owner_label",
          "state",
          "limits",
          "usage",
          "oom_killed",
          "restart_count",
          "flags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "observed_at",
    "env",
    "host",
    "totals",
    "containers"
  ],
  "additionalProperties": false
}
