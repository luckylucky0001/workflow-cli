{
  "$id": "docs/schemas/config.diff.v1.json",
  "title": "config.diff data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "etcd",
        "nacos",
        "consul"
      ],
      "description": "实际使用的 provider（由端点类型决定）"
    },
    "provider_selected_by": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "env": {
      "type": "string"
    },
    "prefix": {
      "type": "string"
    },
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision_space": {
      "type": "string",
      "enum": [
        "etcd-cluster-revision",
        "consul-raft-index",
        "nacos-history-id"
      ],
      "description": "修订号的含义：etcd 集群全局修订；Consul raft 索引（CreateIndex/ModifyIndex/X-Consul-Index）；Nacos 配置历史记录 ID（nid）"
    },
    "mode": {
      "type": "string",
      "enum": [
        "revisions",
        "previous_version"
      ]
    },
    "from_revision": {
      "type": "number",
      "description": "起点（etcd 集群修订；Nacos 历史 ID，表示“该次变更生效后”的状态；0 表示文档创建前）"
    },
    "to_revision": {
      "type": "number"
    },
    "current_revision": {
      "type": "number"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "change": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "changed"
            ]
          },
          "masked": {
            "type": "boolean",
            "description": "任一侧的值被遮蔽；遮蔽时 changed 仍按原始内容判断"
          },
          "old": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "description": "JSON 可解析时为解析后的值，否则为文本；超出 ±2^53 的整数不做有损转换（单值为文本，JSON 内为数字字符串）；binary_base64 时为 base64；被遮蔽时为 \"***\""
                  },
                  "value_format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "text",
                      "binary_base64",
                      "empty"
                    ]
                  },
                  "value_bytes": {
                    "description": "原始值字节数；整个值或其中任一字段被遮蔽时为 null，避免泄露密钥长度",
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "masked": {
                    "type": "boolean"
                  },
                  "masked_paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "被遮蔽的位置：\"$\" 为整个值，\"$.a.b\" 为 JSON 字段"
                  },
                  "mod_revision": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "version": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "create_revision": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "value",
                  "value_format",
                  "value_bytes",
                  "masked",
                  "masked_paths",
                  "mod_revision",
                  "version",
                  "create_revision"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "new": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "description": "JSON 可解析时为解析后的值，否则为文本；超出 ±2^53 的整数不做有损转换（单值为文本，JSON 内为数字字符串）；binary_base64 时为 base64；被遮蔽时为 \"***\""
                  },
                  "value_format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "text",
                      "binary_base64",
                      "empty"
                    ]
                  },
                  "value_bytes": {
                    "description": "原始值字节数；整个值或其中任一字段被遮蔽时为 null，避免泄露密钥长度",
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "masked": {
                    "type": "boolean"
                  },
                  "masked_paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "被遮蔽的位置：\"$\" 为整个值，\"$.a.b\" 为 JSON 字段"
                  },
                  "mod_revision": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "version": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "create_revision": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "value",
                  "value_format",
                  "value_bytes",
                  "masked",
                  "masked_paths",
                  "mod_revision",
                  "version",
                  "create_revision"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "key",
          "change",
          "masked",
          "old",
          "new"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "added": {
          "type": "number"
        },
        "removed": {
          "type": "number"
        },
        "changed": {
          "type": "number"
        },
        "unchanged": {
          "type": "number"
        },
        "rewritten_same_value": {
          "type": "number",
          "description": "值相同但在区间内被重新写入（etcd：mod_revision 变化；Nacos：键级不可知，恒为 0）"
        }
      },
      "required": [
        "added",
        "removed",
        "changed",
        "unchanged",
        "rewritten_same_value"
      ],
      "additionalProperties": false
    },
    "nacos": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "data_id": {
          "type": "string"
        },
        "from_history": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "number"
                },
                "op_type": {
                  "description": "I 新建 / U 修改 / D 删除",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "modified_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "src_user": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "op_type",
                "modified_at",
                "src_user"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "to_history": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "number"
                },
                "op_type": {
                  "description": "I 新建 / U 修改 / D 删除",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "modified_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "src_user": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "op_type",
                "modified_at",
                "src_user"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "history_records": {
          "type": "number",
          "description": "本次读取到的历史记录数（受保留期限制）"
        },
        "oldest_history_id": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "namespace",
        "group",
        "data_id",
        "from_history",
        "to_history",
        "history_records",
        "oldest_history_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "endpoint",
    "provider",
    "provider_selected_by",
    "service",
    "env",
    "prefix",
    "key",
    "revision_space",
    "mode",
    "from_revision",
    "to_revision",
    "current_revision",
    "changes",
    "summary"
  ],
  "additionalProperties": false
}
