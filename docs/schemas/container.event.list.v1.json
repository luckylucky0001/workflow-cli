{
  "$id": "docs/schemas/container.event.list.v1.json",
  "title": "container.event.list data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "string"
    },
    "env": {
      "type": [
        "string",
        "null"
      ]
    },
    "selector": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "label",
            "name"
          ],
          "description": "label=按 Docker 标签 / Kubernetes 标签选择器；name=按资源绑定中声明的精确容器名"
        },
        "label": {
          "type": "string",
          "description": "Docker: key=value；Kubernetes: labelSelector 字符串（如 app=demo-order,tier=web）"
        },
        "origin": {
          "type": "string",
          "enum": [
            "binding-file",
            "label-convention"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "matched_by": {
          "type": "string",
          "description": "实际匹配到容器的选择器，如 label workctl.resource=demo-mysql、binding attribute container=demo-mysql，或 Kubernetes label selector app=demo-order（Deployment demo/demo-order 的 spec.selector）"
        }
      },
      "required": [
        "kind",
        "label",
        "origin",
        "evidence",
        "matched_by"
      ],
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "visible_since": {
      "type": "string",
      "description": "事件历史实际覆盖的起点（Docker 守护进程缓冲 / Kubernetes event-ttl）；早于此的事件不可见"
    },
    "daemon_buffer_full": {
      "type": "boolean",
      "description": "Docker 守护进程事件缓冲是否已满；Kubernetes 恒为 false（保留由 event-ttl 决定，见 retention）"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "container_id": {
            "type": "string"
          },
          "container_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "number",
              "null"
            ]
          },
          "signal": {
            "type": [
              "string",
              "null"
            ]
          },
          "attributes": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "事件属性（不含容器标签）"
          }
        },
        "required": [
          "time",
          "type",
          "action",
          "container_id",
          "container_name",
          "image",
          "exit_code",
          "signal",
          "attributes"
        ],
        "additionalProperties": false
      }
    },
    "counts_by_action": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "provider": {
      "type": "string",
      "enum": [
        "docker",
        "kubernetes"
      ]
    },
    "retention": {
      "description": "仅 Kubernetes provider：事件保留口径",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "kubernetes-event-ttl"
        },
        "ttl": {
          "type": "string"
        },
        "configured": {
          "type": "boolean",
          "description": "false 表示按默认 1h 计算（未在端点 event_ttl 中声明）"
        }
      },
      "required": [
        "kind",
        "ttl",
        "configured"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "service",
    "env",
    "selector",
    "window",
    "visible_since",
    "daemon_buffer_full",
    "events",
    "counts_by_action"
  ],
  "additionalProperties": false
}
