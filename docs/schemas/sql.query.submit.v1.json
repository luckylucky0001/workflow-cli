{
  "$id": "docs/schemas/sql.query.submit.v1.json",
  "title": "sql.query.submit data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query_id": {
      "type": "string"
    },
    "engine": {
      "type": "string",
      "enum": [
        "spark",
        "trino"
      ]
    },
    "state": {
      "type": "string",
      "const": "submitted"
    },
    "submitted_at": {
      "type": "string"
    },
    "pid": {
      "description": "Spark 提交进程 pid；Trino 无本地进程，为 null",
      "type": [
        "number",
        "null"
      ]
    },
    "sql_sha256": {
      "type": "string"
    },
    "result_location": {
      "type": "string"
    },
    "state_file": {
      "type": "string"
    },
    "tables": {
      "type": "string"
    },
    "next": {
      "type": "string"
    },
    "engine_query_id": {
      "description": "Trino query id（仅 Trino）",
      "type": [
        "string",
        "null"
      ]
    },
    "engine_state": {
      "description": "提交返回时 Trino 报告的状态（仅 Trino）",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "query_id",
    "engine",
    "state",
    "submitted_at",
    "pid",
    "sql_sha256",
    "result_location",
    "state_file",
    "tables",
    "next"
  ],
  "additionalProperties": false
}
