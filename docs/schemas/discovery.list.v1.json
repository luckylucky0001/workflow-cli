{
  "$id": "docs/schemas/discovery.list.v1.json",
  "title": "discovery.list data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "etcd",
        "nacos",
        "consul"
      ],
      "description": "实际使用的 provider（由端点类型决定）"
    },
    "provider_selected_by": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "env": {
      "type": [
        "string",
        "null"
      ]
    },
    "prefix": {
      "type": "string",
      "description": "etcd：注册键前缀；Consul：/v1/health/service/<service>；Nacos：<namespace>/<group>@@<service>"
    },
    "observed_revision": {
      "description": "etcd 集群修订；Consul X-Consul-Index；Nacos 为 null",
      "type": [
        "number",
        "null"
      ]
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "description": "etcd：<discovery_prefix><service>/ 之后的键名；Consul：Service.ID；Nacos：instanceId"
          },
          "key": {
            "type": "string"
          },
          "payload": {
            "description": "注册内容（etcd JSON；Consul Service.Meta + Tags；Nacos metadata；敏感字段遮蔽）；无法解析时为 null"
          },
          "payload_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": [
              "number",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "type": [
              "string",
              "null"
            ]
          },
          "healthy": {
            "description": "etcd：实例自报的 healthy 字段；Consul：健康检查聚合（critical → false）；Nacos：服务端健康状态；缺失为 null",
            "type": [
              "boolean",
              "null"
            ]
          },
          "health_basis": {
            "description": "healthy 的依据",
            "type": "string",
            "enum": [
              "self_reported",
              "registry_checks",
              "registry_health"
            ]
          },
          "registered_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "create_revision": {
            "type": [
              "number",
              "null"
            ]
          },
          "mod_revision": {
            "type": [
              "number",
              "null"
            ]
          },
          "lease": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "granted_ttl_s": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "remaining_ttl_s": {
                    "description": "剩余 TTL（秒）；-1 表示租约已过期/不存在",
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "granted_ttl_s",
                  "remaining_ttl_s",
                  "error"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "etcd 租约；null 表示注册未绑定租约（Consul / Nacos 恒为 null，见各自字段）"
          },
          "consul": {
            "type": "object",
            "properties": {
              "node": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "passing",
                  "warning",
                  "critical"
                ],
                "description": "该实例全部检查（含节点级检查）的最差状态"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "check_id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "service_level": {
                      "type": "boolean"
                    },
                    "output": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "check_id",
                    "name",
                    "status",
                    "service_level",
                    "output"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "node",
              "status",
              "tags",
              "checks"
            ],
            "additionalProperties": false
          },
          "nacos": {
            "type": "object",
            "properties": {
              "cluster": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "weight": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "enabled": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "ephemeral": {
                "description": "true：临时实例（客户端心跳/连接维持，停止后自动摘除）；false：持久实例（服务端主动探测，不会自动删除）",
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "cluster",
              "weight",
              "enabled",
              "ephemeral"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "instance_id",
          "key",
          "payload",
          "payload_error",
          "address",
          "port",
          "version",
          "env",
          "healthy",
          "registered_at",
          "create_revision",
          "mod_revision",
          "lease"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "registered": {
          "type": "number",
          "description": "注册总数（过滤前）"
        },
        "returned": {
          "type": "number"
        },
        "healthy": {
          "type": "number",
          "description": "健康实例数；Nacos 不计 enabled=false（已下线）的实例（见 disabled）"
        },
        "unhealthy": {
          "type": "number"
        },
        "health_unknown": {
          "type": "number"
        },
        "without_lease": {
          "type": "number",
          "description": "etcd：没有租约的注册数；Consul / Nacos 为 0（不适用）"
        },
        "disabled": {
          "description": "Nacos：enabled=false（已下线、不接收流量）的实例数；它们不计入 healthy，--healthy-only 时排除",
          "type": "number"
        },
        "excluded": {
          "type": "object",
          "properties": {
            "env_mismatch": {
              "type": "number"
            },
            "env_missing": {
              "type": "number"
            },
            "not_healthy": {
              "type": "number"
            },
            "disabled": {
              "description": "Nacos：--healthy-only 排除的 enabled=false 实例",
              "type": "number"
            }
          },
          "required": [
            "env_mismatch",
            "env_missing",
            "not_healthy"
          ],
          "additionalProperties": false
        },
        "service_registered": {
          "description": "Consul / Nacos：服务名是否在注册中心目录中（区分“未注册”与“0 个实例”）；无法判断为 null",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "registered",
        "returned",
        "healthy",
        "unhealthy",
        "health_unknown",
        "without_lease",
        "excluded"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "endpoint",
    "provider",
    "provider_selected_by",
    "service",
    "env",
    "prefix",
    "observed_revision",
    "instances",
    "summary"
  ],
  "additionalProperties": false
}
