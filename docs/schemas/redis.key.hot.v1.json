{
  "$id": "docs/schemas/redis.key.hot.v1.json",
  "title": "redis.key.hot data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instance": {
      "type": "string"
    },
    "maxmemory_policy": {
      "type": "string"
    },
    "lfu": {
      "type": "object",
      "properties": {
        "log_factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "decay_time_min": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "log_factor",
        "decay_time_min"
      ],
      "additionalProperties": false
    },
    "scan": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string"
        },
        "scan_count_hint": {
          "type": "number"
        },
        "scan_calls": {
          "type": "number"
        },
        "unique_keys": {
          "type": "number"
        },
        "duplicates_seen": {
          "type": "number"
        },
        "cursor_complete": {
          "type": "boolean",
          "description": "游标在预算内回到 0（完整遍历一次，但仍不是一致性快照）"
        },
        "stopped_by": {
          "type": "string",
          "enum": [
            "cursor_complete",
            "max_keys",
            "max_scan_calls",
            "time_budget"
          ]
        }
      },
      "required": [
        "pattern",
        "scan_count_hint",
        "scan_calls",
        "unique_keys",
        "duplicates_seen",
        "cursor_complete",
        "stopped_by"
      ],
      "additionalProperties": false
    },
    "hot_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "lfu_counter": {
            "type": "number"
          }
        },
        "required": [
          "key",
          "lfu_counter"
        ],
        "additionalProperties": false
      }
    },
    "counter_distribution": {
      "type": "object",
      "properties": {
        "p50": {
          "type": [
            "number",
            "null"
          ]
        },
        "p90": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "p50",
        "p90",
        "max"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "instance",
    "maxmemory_policy",
    "lfu",
    "scan",
    "hot_keys",
    "counter_distribution"
  ],
  "additionalProperties": false
}
