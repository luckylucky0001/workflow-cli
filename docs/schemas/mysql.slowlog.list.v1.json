            "type": [
              "number",
              "null"
            ]
          },
          "rows_sent": {
            "type": [
              "number",
              "null"
            ]
          },
          "rows_examined": {
            "type": [
              "number",
              "null"
            ]
          },
          "db": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_host": {
            "type": [
              "string",
              "null"
            ]
          },
          "thread_id": {
            "type": [
              "number",
              "null"
            ]
