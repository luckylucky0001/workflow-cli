{
  "$id": "docs/schemas/redis.key.sample.v1.json",
  "title": "redis.key.sample data",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instance": {
      "type": "string"
    },
    "db": {
      "type": "number"
    },
    "keys_in_db": {
      "description": "DBSIZE（全库键数，含不匹配模式的键）",
      "type": [
        "number",
        "null"
      ]
    },
    "scan": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string"
        },
        "scan_count_hint": {
          "type": "number"
        },
        "scan_calls": {
          "type": "number"
        },
        "unique_keys": {
          "type": "number"
        },
        "duplicates_seen": {
          "type": "number"
        },
        "cursor_complete": {
          "type": "boolean",
          "description": "游标在预算内回到 0（完整遍历一次，但仍不是一致性快照）"
        },
        "stopped_by": {
          "type": "string",
          "enum": [
            "cursor_complete",
            "max_keys",
            "max_scan_calls",
            "time_budget"
          ]
        }
      },
      "required": [
        "pattern",
        "scan_count_hint",
        "scan_calls",
        "unique_keys",
        "duplicates_seen",
        "cursor_complete",
        "stopped_by"
      ],
      "additionalProperties": false
    },
    "sampled_keys": {
      "type": "number"
    },
    "vanished_keys": {
      "type": "number",
      "description": "SCAN 返回后、读取类型前已不存在的键"
    },
    "type_counts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "memory_bytes": {
      "type": "object",
      "properties": {
        "p50": {
          "type": [
            "number",
            "null"
          ]
        },
        "p90": {
          "type": [
            "number",
            "null"
          ]
        },
        "p99": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "sum_sampled": {
          "type": "number"
        }
      },
      "required": [
        "p50",
        "p90",
        "p99",
        "max",
        "mean",
        "sum_sampled"
      ],
      "additionalProperties": false
    },
    "top_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "memory_bytes": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "type",
          "memory_bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "instance",
    "db",
    "keys_in_db",
    "scan",
    "sampled_keys",
    "vanished_keys",
    "type_counts",
    "memory_bytes",
    "top_keys"
  ],
  "additionalProperties": false
}
