   "status:paid AND city:shanghai",
   "--max-hits",
   "5"
  ],
  "note": "query_string：total relation=eq（精确），只返回 5 条 → coverage.truncated=true"
 },
 {
  "id": "search-09",
  "args": [
   "search",
   "query",
   "--cluster",
