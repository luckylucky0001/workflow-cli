# Prebuilt bundle only (no npm install in the image). Build it first:
#   node demo/sample-service/build.mjs
FROM node:22-alpine
WORKDIR /app
COPY dist/server.cjs /app/server.cjs
ENV NODE_ENV=production PORT=8080
EXPOSE 8080
# Runs as root on purpose: the demo mounts mode-600 secret files generated by up.sh.
CMD ["node", "/app/server.cjs"]
